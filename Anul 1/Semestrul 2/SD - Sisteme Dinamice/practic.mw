<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">#ex 1
#a)
restart;
with(DEtools):
with(plots):
ecdif1:=x*diff(y(x), x)+k*y(x)=x^4+y(x);
sol1:=dsolve(ecdif1, y(x));
</Text-field>
</Input>
