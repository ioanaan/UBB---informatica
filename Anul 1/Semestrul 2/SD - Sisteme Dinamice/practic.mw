<Group hide-input="false" labelreference="L2" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">#ex 2
#a)
restart;
with(DEtools):
with(plots):
ecdif2:=x^2*diff(y(x), x$2)+ 2*x*diff(y(x), x)+4*y(x)=0;
